/* ===== tela Adicionar música ===== */

QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 @fundo_a, stop:1 @fundo_b);
    color: @texto;
}
QMainWindow > QWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 @fundo_a, stop:1 @fundo_b);
}
QWidget { font-family: "Manrope"; color: @texto; }
QLabel#barraTitulo, QLabel#barraArtista, QLabel#painelTitulo,
QLabel#painelArtista, QLineEdit#campoItem, QLineEdit#campoArtista {
    font-family: "Zen Maru Gothic";
}
QLabel#painelTitulo {
    font-size: 20px; font-weight: 700; color: @texto;
}
QLabel#painelArtista {
    font-size: 16px; color: @texto_suave;
}

QFrame#lateral {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 @superficie_a, stop:1 @superficie_b);
    border-right: 1px solid @borda;
}
QFrame#painelAtual {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 @superficie_a, stop:1 @superficie_b);
    border-left: 1px solid @borda;
}
QFrame#barraPlayer {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 @superficie_a, stop:1 @superficie_b);
    border-top: 1px solid @borda;
}
QFrame#lateral[mafty="true"],
QFrame#painelAtual[mafty="true"],
QFrame#barraPlayer[mafty="true"] {
    background: @superficie;
}
QLabel#secao { color: @texto_suave; }
QLabel#logo {
    font-family: "Zen Maru Gothic";
    font-size: 24px;
    font-weight: 700;
}

QPushButton#navegacao {
    background: transparent; color: @texto_suave;
    border: none; border-left: 2px solid transparent; border-radius: @raio;
    text-align: left; padding: 8px 10px;
}
QPushButton#adicionar { text-align: left; padding: 8px 10px; }
QPushButton#navegacao:hover { background: @cartao; color: @texto; }
QPushButton#navegacao:checked {
    background: @azul_escuro; color: @azul_claro;
    border-left: 2px solid @azul;
}
QPushButton#coracao {
    background: transparent; border: none; color: @lilas_claro;
}
QPushButton#coracao:hover {
    background: @lilas_escuro; color: @texto; border-radius: @raio;
}
QPushButton#coracao[acaoPainel="true"] { padding: 0; border-radius: @raio; }
QPushButton#coracao[acaoPainel="true"]:hover { background: @elevado; }
QLabel#selo {
    background: @lilas_escuro; border: 1px solid @lilas; border-radius: @raio;
    color: @texto; padding: 2px 6px;
}
QFrame#divisor { background: @borda; border: none; }

QLineEdit {
    background: @cartao; border: 1px solid @borda_forte;
    border-radius: @raio; color: @texto; padding: 6px 8px;
    selection-background-color: @azul;
    selection-color: @texto_sobre_destaque;
}
QLineEdit:focus { border-color: @azul; }
QPlainTextEdit#editorLetra {
    background: @cartao; border: 1px solid @borda_forte; border-radius: @raio;
    color: @texto; padding: 4px;
    selection-background-color: @azul;
    selection-color: @texto_sobre_destaque;
}
QPushButton#botaoIcone {
    background: transparent; border: none; border-radius: @raio;
    color: @texto_suave; padding: 4px;
}
QPushButton#botaoIcone:hover { background: @elevado; color: @texto; }
QPushButton#botaoIcone:checked { color: @azul_claro; }
QStackedWidget, QStackedWidget > QWidget, QScrollArea, QListWidget {
    background: transparent; border: none;
}
QStackedWidget[mafty="true"] { background: @superficie; }
QAbstractScrollArea::viewport { background: transparent; }
QListWidget { outline: none; }
QListWidget::item { background: transparent; }

QScrollArea#areaLista > QWidget > QWidget { background: transparent; }
QScrollArea#areaLista QScrollBar:vertical,
QListWidget#areaLista QScrollBar:vertical,
QListWidget#listaPalco QScrollBar:vertical,
QPlainTextEdit#editorLetra QScrollBar:vertical {
    width: 0; margin: 0;
}
QScrollArea#areaLista QScrollBar:horizontal,
QListWidget#areaLista QScrollBar:horizontal,
QListWidget#listaPalco QScrollBar:horizontal,
QPlainTextEdit#editorLetra QScrollBar:horizontal {
    height: 0; margin: 0;
}
QPushButton#secundario[acaoPainel="true"] {
    background: transparent; border: none; border-radius: @raio; padding: 0;
}
QPushButton#secundario[acaoPainel="true"]:hover {
    background: @elevado;
}
QPushButton#secundario[acaoPainel="true"]:checked {
    background: @azul_escuro; color: @azul_claro;
}

QFrame#zonaArraste {
    background: @fundo; border: 1px dashed @borda; border-radius: @raio;
}
QFrame#zonaArraste[arrastando="true"] {
    border: 1px dashed @azul; background: @superficie;
}
#uploadIcone { font-size: 26px; color: @texto_suave; }
QSlider::groove:horizontal {
    background: @azul_escuro; border: none; height: 4px; border-radius: @raio;
}
QSlider::sub-page:horizontal { background: @azul; border-radius: @raio; }
QSlider::add-page:horizontal { background: @azul_escuro; border-radius: @raio; }
QSlider::handle:horizontal {
    background: transparent; border: none;
    width: 18px; height: 18px; margin: -7px 0;
    border-radius: @raio_puxador;
}
QSlider::handle:horizontal:hover { background: transparent; }
QPushButton#botaoPlay {
    background: @azul; color: @texto_sobre_destaque;
    border: none; border-radius: @raio;
}
QPushButton#botaoPlay:hover { background: @azul_claro; }
QPushButton#botaoPlay[palco="true"] {
    border-radius: 24px; padding: 0;
}
QPushButton#botaoPlay[palco="true"][mafty="true"] { border-radius: 0px; }

QFrame#card, QFrame#itemArquivo {
    background: @cartao; border: 1px solid @borda; border-radius: @raio;
}
QLabel#tituloPagina[tituloPlaylists="true"] {
    font-size: 26px; font-weight: 700;
}
QFrame#palcoPlaylists {
    background: transparent; border: 1px solid @borda; border-radius: @raio;
}
QFrame#palcoPlaylists[mafty="true"] { border-radius: 0px; }
QLabel#capaPalco {
    background: transparent; border: none; border-radius: @raio;
}
QLabel#capaPalco[mafty="true"] { border-radius: 0px; }
QLabel#etiquetaPlaylist {
    color: @texto_fraco; font-size: 11px; font-weight: 600;
    letter-spacing: 1px;
}
QLabel#nomePalco {
    background: transparent; color: @texto;
    font-size: 30px; font-weight: 700;
}
QLabel#infoPalco { color: @texto_suave; font-size: 15px; }
QPushButton#secundario[botaoIconePlaylist="true"] {
    background: transparent; border: none; border-radius: @raio;
    color: @texto_suave; padding: 4px;
}
QPushButton#secundario[botaoIconePlaylist="true"]:hover {
    background: @elevado; color: @texto;
}
QPushButton#playlistPill {
    background: @cartao; border: 1px solid @borda; border-radius: 22px;
    color: @texto; padding: 5px 12px; text-align: left; font-size: 13px;
}
QPushButton#playlistPill[mafty="true"] { border-radius: 0px; }
QPushButton#playlistPill:hover { background: @elevado; }
QPushButton#playlistPill[selecionada="true"] {
    border-color: @azul; background: @elevado;
}
QLabel#tituloPagina[tituloConfiguracoes="true"] {
    font-size: 28px; font-weight: 700;
}
QFrame#cartaoTema {
    background: @cartao; border: 1px solid @borda; border-radius: 6px;
}
QFrame#cartaoTema[selecionado="true"] { border-color: @azul; }
QFrame#cartaoTema:hover { background: @elevado; }
QFrame#cartaoTema[mafty="true"] { border-radius: 0px; }
QLabel#amostraTema {
    border: 1px solid @borda; border-radius: @raio;
}
QLabel#cardTitulo[secaoConfiguracoes="true"] {
    font-size: 16px; font-weight: 600;
}
QLabel#cardTitulo[tituloTema="true"] {
    font-size: 13px; font-weight: 600;
}
#cardTitulo { font-size: 15px; }
#cardDesc { font-size: 13px; color: @texto_suave; }
#infoItem { font-size: 12px; color: @texto_suave; }
#status { font-size: 13px; color: @texto_suave; }

/* campos de texto dentro de cada arquivo */
QLineEdit#campoItem, QLineEdit#campoArtista {
    background: @cartao; border: 1px solid @borda_forte; border-radius: @raio;
    padding: 2px 6px; min-width: 0;
}
QLineEdit#campoItem { font-size: 15px; font-weight: 600; }
QLineEdit#campoArtista { font-size: 13px; color: @texto_suave; }
QLineEdit#campoItem:hover, QLineEdit#campoArtista:hover { border-color: @borda_forte; }
QLineEdit#campoItem:focus, QLineEdit#campoArtista:focus {
    border-color: @azul; background: @cartao;
}

/* botão de capa */
QPushButton#capaEscolher {
    background: @elevado; border: 1px dashed @borda_forte; border-radius: @raio;
    color: @texto_suave; font-size: 12px;
}
QPushButton#capaEscolher:hover {
    border-color: @azul; color: @texto;
}

/* botões de qualidade (128 / 192 / 320) */
QPushButton#qualidade {
    background: transparent; border: 1px solid @borda_forte; border-radius: @raio;
    padding: 6px 12px; color: @texto_suave;
    font-family: "Consolas", monospace; font-size: 13px;
}
QPushButton#qualidade:hover { color: @texto; }
QPushButton#qualidade:checked {
    background: @elevado; border-color: @azul; color: @texto;
}
QPushButton#qualidade:disabled { color: @texto_fraco; border-color: @borda; }

/* botões gerais */
QPushButton#secundario {
    background: @elevado; border: 1px solid @borda_forte; border-radius: @raio;
    padding: 8px 16px;
}
QPushButton#secundario:hover { background: @elevado; }

QPushButton#primario {
    background: @azul; color: @texto_sobre_destaque;
    border: none; border-radius: @raio;
    padding: 10px 18px; font-weight: 600;
}
QPushButton#primario:hover {
    background: @azul_claro; color: @texto_sobre_destaque;
}
QPushButton#primario:disabled { background: @elevado; color: @texto_suave; }

/* lista de playlists */
QComboBox {
    background: @cartao; border: 1px solid @borda_forte; border-radius: @raio;
    padding: 8px 12px; min-width: 150px;
}
QComboBox:hover, QComboBox:focus { border-color: @azul; }
QComboBox QAbstractItemView {
    background: @cartao; border: 1px solid @borda_forte;
    selection-background-color: @azul;
    selection-color: @texto_sobre_destaque; outline: none;
}

QToolTip {
    background: @elevado; color: @texto; border: 1px solid @borda; padding: 4px 8px;
}

/* ===== playlists: menu do pincel e janelas de diálogo ===== */

QMenu {
    background: @cartao; border: 1px solid @borda; padding: 4px;
}
QMenu::item { padding: 8px 24px 8px 14px; border-radius: @raio; }
QMenu::item:selected {
    background: @azul; color: @texto_sobre_destaque;
}
QMenu::separator { height: 1px; background: @borda; margin: 4px 6px; }

QDialog { background: @superficie; }
QDialog QLabel { color: @texto; }
QDialog QPushButton {
    background: @elevado; border: 1px solid @borda_forte; border-radius: @raio;
    padding: 7px 18px; min-width: 70px;
}
QDialog QPushButton:hover { background: @elevado; }
QDialog QPushButton:default { border-color: @azul; color: @azul; }

/* ===== menu de botão direito (coração, fila, lixeira) ===== */

QFrame#menuMusica {
    background: @cartao; border: 1px solid @borda; border-radius: @raio;
}

QPushButton#botaoMenu {
    background: transparent; border: none; border-radius: @raio; padding: 0;
}
QPushButton#botaoMenu:hover { background: @elevado; }
QPushButton#botaoMenu:pressed { background: @elevado; }